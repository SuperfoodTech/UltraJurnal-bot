# ============================================================
#  Environment Variables — UltraJurnal.bot Discord Bot
# ============================================================
#  Salin file ini menjadi ".env" dan isi nilainya.
#  JANGAN commit file .env ke Git!
# ============================================================

# ── Discord ──────────────────────────────────────────────────
# Token bot dari https://discord.com/developers/applications
DISCORD_BOT_TOKEN=GANTI_DENGAN_TOKEN_BOT_KAMU

# ── Google Drive via Apps Script ─────────────────────────────
# URL Web App hasil Deploy dari gdrive_upload.gs
# Cara deploy: Apps Script Editor → Deploy → New Deployment
#   - Type: Web App
#   - Execute as: Me
#   - Who has access: Anyone
# Salin URL yang muncul di sini:
APPSCRIPT_WEBAPP_URL=GANTI_DENGAN_URL_DEPLOY_APPS_SCRIPT

# Target folder GDrive (sudah dikonfigurasi di Apps Script):
# https://drive.google.com/drive/folders/17jmj2j6WjsyEgxBNV7XOK6GT_2FplaXy
